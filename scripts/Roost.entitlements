<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Clicking an agent asks iTerm2 or Terminal (via atc) to bring its tab forward. Under the hardened
       runtime macOS refuses Apple Events without this, and never even asks. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
